+TEST_F(ImuManagerTester, WhoAmIProbeFailureReturnsToReset) {
+    this->nominal_boot_sequence();
+    // Fail the WHO_AM_I probe: configuration must stop before the accelerometer write, report the error and go to RESET
+    this->failureRate = 100;
+    this->tick();
+    ASSERT_from_busWriteRead_SIZE(1);
+    ASSERT_from_busWrite_SIZE(0);
+    ASSERT_EVENTS_I2cError_SIZE(1);
+    ASSERT_EQ(this->state, ImuManagerTester::State::RESET);
+    // Recover: the next tick starts the reset sequence again
+    this->failureRate = 0;
+    this->clearHistory();
+    this->tick();
+    this->verify_state_and_clear(ImuManagerTester::State::WAIT_RESET);
+}
